+
+  it('telegramWebhook es raw (sin envelope) y auth none', () => {
+    expect(FN_REGISTRY.telegramWebhook).toMatchObject({ auth: 'none', raw: true });
+    expect(typeof FN_REGISTRY.telegramWebhook.handler).toBe('function');
