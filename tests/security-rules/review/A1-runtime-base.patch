+  it('auth-class de cada ruta coincide con la tabla del spec', () => {
+    for (const { name, auth } of SPEC_ROUTES) {
+      expect(FN_REGISTRY[name].auth, `auth de ${name}`).toBe(auth);
+    }
+  });
+});
+
+describe('rutas 404 del dispatch', () => {
