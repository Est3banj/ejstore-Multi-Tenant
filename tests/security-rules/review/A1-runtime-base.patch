+    expect(res.body).toEqual({
+      error: {
+        code: 'not-found',
+        status: 'NOT_FOUND',
+        message: 'Operación no disponible',
+      },
+    });
+  });
+
+  it('POST /api/nonexistent → 404 Función no encontrada', async () => {
+    const res = await request(app).post('/api/nonexistent').send({ data: {} });
