+function toHttpError(errorCode, customMessage = null) {
+  const mapping = ERROR_HTTP_MAP[errorCode] || ERROR_HTTP_MAP[ErrorCode.INTERNAL_ERROR];
+  return {
+    status: mapping.status,
+    message: customMessage || mapping.message,
+    code: errorCode,
